    "click": {"source": "animations/click.png", "grid": [4, 2], "frames": 8, "fps": 10, "loop": false, "cooldown": 1000, "interruptible": false},
    "wave": {"source": "animations/wave.png", "grid": [4, 2], "frames": 8, "fps": 10, "loop": false, "interruptible": true},
    "walk": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [1, 0], "offset_x": -22},
    "sit": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [2, 0], "offset_x": -4},
    "stretch": {"source": "animations/stretch.png", "grid": [4, 2], "frames": 8, "fps": 10, "loop": false, "interruptible": true},
    "critical": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [1, 1], "offset_x": -10},
    "sleep": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [2, 1], "offset_x": -10},
    "sleep_react": {"source": "animations/sleep_react.png", "grid": [4, 2], "frames": 8, "fps": 9, "loop": false, "cooldown": 1000, "interruptible": false}
