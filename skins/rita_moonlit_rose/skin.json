{
  "schema_version": 1,
  "id": "rita_moonlit_rose",
  "name": "丽塔 · 月下蔷薇",
  "author": "Codex Usage Pet",
  "version": "1.0",
  "description": "独立打包的冷色月光主题丽塔 Q 版皮肤。",
  "preview": "preview.png",
  "preferred_width": 222,
  "preferred_height": 222,
  "anchor_x": 0,
  "anchor_y": -3,
  "theme": {
    "background": "#15151C",
    "panel": "#23232F",
    "progress_track": "#343443",
    "primary": "#8F7EB8",
    "highlight": "#B9A8DD",
    "critical": "#9B5278",
    "empty": "#777382",
    "low": "#C9BCD9",
    "text_primary": "#F1EEF6",
    "text_secondary": "#B8B1C5",
    "border": "#62517F",
    "decorator": "◇"
  },
  "action_policy": {
    "idle_trigger_probability": 0.48,
    "idle_interval_min": 60,
    "idle_interval_max": 180,
    "avoid_immediate_repeat": true,
    "history_size": 3,
    "pools": {
      "hover": [
        {"action": "blink", "weight": 55, "cooldown": [6000, 18000], "allowed_states": ["normal"]},
        {"action": "hover", "weight": 20, "cooldown": [5000, 12000], "allowed_states": ["normal"]}
      ],
      "click": [
        {"action": "click", "weight": 35, "cooldown": [1500, 3500], "allowed_states": ["normal", "low"]},
        {"action": "wave", "weight": 35, "cooldown": [45000, 120000], "allowed_states": ["normal", "low"]},
        {"action": "stretch", "weight": 15, "cooldown": [90000, 210000], "allowed_states": ["normal", "low"]},
        {"action": "sleep_react", "weight": 75, "cooldown": [2500, 6000], "allowed_states": ["empty"]}
      ],
      "idle_random": [
        {"action": "blink", "weight": 50, "cooldown": [6000, 18000], "allowed_states": ["normal"]},
        {"action": "wave", "weight": 24, "cooldown": [75000, 210000], "allowed_states": ["normal"]},
        {"action": "stretch", "weight": 11, "cooldown": [120000, 300000], "allowed_states": ["normal"]},
        {"action": "none", "weight": 15, "allowed_states": ["normal"]}
      ],
      "recovered": [
        {"action": "wave", "weight": 45, "allowed_states": ["recovered"]},
        {"action": "hover", "weight": 30, "allowed_states": ["recovered"]},
        {"action": "stretch", "weight": 20, "allowed_states": ["recovered"]},
        {"action": "none", "weight": 5, "allowed_states": ["recovered"]}
      ],
      "low_on_enter": [
        {"action": "sit_transition", "weight": 65, "allowed_states": ["low"]},
        {"action": "none", "weight": 35, "allowed_states": ["low"]}
      ],
      "low_idle": [
        {"action": "sit", "weight": 80, "allowed_states": ["low"]},
        {"action": "idle", "weight": 20, "allowed_states": ["low"]}
      ],
      "low_on_exit": [{"action": "none", "weight": 100, "allowed_states": ["low"]}],
      "critical_idle": [
        {"action": "critical", "weight": 75, "allowed_states": ["critical"]},
        {"action": "sit", "weight": 25, "allowed_states": ["critical"]}
      ],
      "empty_idle": [{"action": "sleep", "weight": 100, "allowed_states": ["empty"]}]
    }
  },
  "states": {
    "idle": {"source": "animations/blink.png", "grid": [3, 2], "cell": [0, 0]},
    "blink": {"source": "animations/blink.png", "grid": [3, 2], "frames": 6, "fps": 20, "frame_durations_ms": [150, 70, 70, 110, 70, 130], "loop": false, "cooldown": 1500, "interruptible": true},
    "hover": {"source": "animations/hover.png", "grid": [3, 2], "frames": 6, "fps": 24, "frame_durations_ms": [180, 160, 180, 240, 180, 160], "loop": false, "cooldown": 1500, "interruptible": true},
    "click": {"source": "animations/click.png", "grid": [4, 2], "frames": 8, "fps": 24, "frame_durations_ms": [160, 140, 160, 240, 280, 220, 160, 140], "loop": false, "cooldown": 1000, "interruptible": false},
    "wave": {"source": "animations/wave.png", "grid": [4, 2], "frames": 8, "fps": 24, "frame_durations_ms": [260, 220, 220, 320, 420, 360, 320, 280], "loop": false, "interruptible": true},
    "walk": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [1, 0]},
    "sit": {"source": "animations/sit_transition.png", "grid": [5, 2], "cell": [4, 1]},
    "sit_transition": {"source": "animations/sit_transition.png", "grid": [5, 2], "frames": 10, "fps": 24, "frame_durations_ms": [140, 140, 140, 160, 180, 220, 180, 160, 140, 140], "loop": false, "interruptible": false},
    "stretch": {"source": "animations/tidy_hair.png", "grid": [4, 3], "frames": 12, "fps": 24, "frame_durations_ms": [240, 180, 180, 180, 180, 320, 420, 320, 260, 240, 220, 180], "loop": false, "interruptible": true},
    "critical": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [1, 1]},
    "sleep": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [2, 1]},
    "sleep_react": {"source": "animations/sleep_react.png", "grid": [4, 2], "frames": 8, "fps": 20, "frame_durations_ms": [320, 240, 240, 360, 420, 360, 260, 200], "loop": false, "cooldown": 1000, "interruptible": false}
  }
}
