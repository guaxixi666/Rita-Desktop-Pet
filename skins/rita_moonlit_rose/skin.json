    "highlight": "#B9A8DD",
    "critical": "#9B5278",
    "empty": "#777382",
    "low": "#C9BCD9",
    "text_primary": "#F1EEF6",
    "text_secondary": "#B8B1C5",
    "border": "#62517F",
