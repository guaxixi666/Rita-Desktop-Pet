{
  "schema_version": 1,
  "id": "rita_moonlit_rose",
  "name": "丽塔 · 月下蔷薇",
  "author": "Rita Desktop Pet",
  "version": "1.0",
  "description": "独立打包的冷色月光主题丽塔 Q 版皮肤。",
  "preview": "preview.png",
  "preferred_width": 222,
  "preferred_height": 222,
  "anchor_x": 0,
  "anchor_y": -3,
  "theme": {
    "background": "#15151C",
    "panel": "#23232F",
    "progress_track": "#343443",
    "primary": "#8F7EB8",
    "highlight": "#B9A8DD",
    "critical": "#9B5278",
    "empty": "#777382",
    "low": "#C9BCD9",
    "text_primary": "#F1EEF6",
    "text_secondary": "#B8B1C5",
    "border": "#62517F",
    "decorator": "◇"
  },
  "action_policy": {
    "idle_trigger_probability": 0.48,
    "idle_interval_min": 60,
    "idle_interval_max": 180,
    "avoid_immediate_repeat": true,
    "history_size": 3,
    "pools": {
      "click": [
        {"action": "smile", "weight": 32, "cooldown": [2000, 6000]},
        {"action": "wave", "weight": 22, "cooldown": [45000, 120000]},
        {"action": "surprised", "weight": 20, "cooldown": [1500, 3500]},
        {"action": "tidy_hair", "weight": 12, "cooldown": [90000, 210000]},
        {"action": "sit", "weight": 5, "cooldown": [120000, 300000]},
        {"action": "sleepy", "weight": 4, "cooldown": [180000, 360000]},
        {"action": "none", "weight": 5}
      ],
      "idle_random": [
        {"action": "blink", "weight": 50, "cooldown": [6000, 18000]},
        {"action": "smile", "weight": 20, "cooldown": [25000, 70000]},
        {"action": "tidy_hair", "weight": 10, "cooldown": [120000, 300000]},
        {"action": "wave", "weight": 7, "cooldown": [75000, 210000]},
        {"action": "sit", "weight": 4, "cooldown": [150000, 360000]},
        {"action": "sleepy", "weight": 4, "cooldown": [180000, 420000]},
        {"action": "none", "weight": 5}
      ]
    }
  },
