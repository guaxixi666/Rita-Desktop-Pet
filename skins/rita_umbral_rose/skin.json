{
  "schema_version": 1,
  "id": "rita_umbral_rose",
  "name": "丽塔 · 黯蔷薇",
  "author": "Codex Usage Pet",
  "version": "1.0",
  "description": "原创绘制的丽塔风格 Q 版黯蔷薇主题皮肤。",
  "preview": "preview.png",
  "preferred_width": 222,
  "preferred_height": 222,
  "anchor_x": 0,
  "anchor_y": -3,
  "theme": {
    "background": "#17171D",
    "panel": "#24222B",
    "progress_track": "#35313A",
    "primary": "#C05A78",
    "highlight": "#DA7892",
    "critical": "#87364E",
    "empty": "#958594",
    "low": "#E8C3CD",
    "text_primary": "#F3ECEE",
    "text_secondary": "#BDAFB5",
    "border": "#87364E",
    "decorator": "✿"
  },
  "action_policy": {
    "idle_trigger_probability": 0.62,
    "idle_interval_min": 45,
    "idle_interval_max": 150,
    "avoid_immediate_repeat": true,
    "history_size": 3,
    "pools": {
      "click": [
        {"action": "surprised", "weight": 30, "cooldown": [1000, 2500]},
        {"action": "smile", "weight": 25, "cooldown": [2000, 5000]},
        {"action": "wave", "weight": 18, "cooldown": [30000, 90000]},
        {"action": "tidy_hair", "weight": 14, "cooldown": [60000, 150000]},
        {"action": "sit", "weight": 6, "cooldown": [90000, 240000]},
        {"action": "sleepy", "weight": 4, "cooldown": [120000, 300000]},
        {"action": "none", "weight": 3}
      ],
      "idle_random": [
        {"action": "blink", "weight": 45, "cooldown": [5000, 15000]},
        {"action": "smile", "weight": 22, "cooldown": [20000, 60000]},
        {"action": "tidy_hair", "weight": 14, "cooldown": [90000, 240000]},
        {"action": "wave", "weight": 8, "cooldown": [60000, 180000]},
        {"action": "sit", "weight": 4, "cooldown": [120000, 300000]},
        {"action": "sleepy", "weight": 3, "cooldown": [180000, 420000]},
        {"action": "none", "weight": 4}
      ]
    }
  },
  "states": {
    "idle": {"source": "animations/blink.png", "grid": [3, 2], "cell": [0, 0]},
    "blink": {"source": "animations/blink.png", "grid": [3, 2], "frames": 6, "fps": 20, "frame_durations_ms": [150, 70, 70, 110, 70, 130], "loop": false, "cooldown": 1500, "interruptible": true},
    "hover": {"source": "animations/hover.png", "grid": [3, 2], "frames": 6, "fps": 24, "frame_durations_ms": [180, 160, 180, 240, 180, 160], "loop": false, "cooldown": 1500, "interruptible": true},
    "click": {"source": "animations/click.png", "grid": [4, 2], "frames": 8, "fps": 24, "frame_durations_ms": [160, 140, 160, 240, 280, 220, 160, 140], "loop": false, "cooldown": 1000, "interruptible": false},
    "wave": {"source": "animations/wave.png", "grid": [4, 2], "frames": 8, "fps": 24, "frame_durations_ms": [260, 220, 220, 320, 420, 360, 320, 280], "loop": false, "interruptible": true},
    "walk": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [1, 0]},
    "smile": {"source": "animations/hover.png", "grid": [3, 2], "frames": 6, "fps": 24, "frame_durations_ms": [180, 160, 180, 240, 180, 160], "loop": false, "cooldown": 1500, "interruptible": true},
    "surprised": {"source": "animations/click.png", "grid": [4, 2], "frames": 8, "fps": 24, "frame_durations_ms": [160, 140, 160, 240, 280, 220, 160, 140], "loop": false, "cooldown": 1000, "interruptible": false},
    "tidy_hair": {"source": "animations/tidy_hair.png", "grid": [4, 3], "frames": 12, "fps": 24, "frame_durations_ms": [240, 180, 180, 180, 180, 320, 420, 320, 260, 240, 220, 180], "loop": false, "interruptible": true},
    "sit": {"source": "animations/sit_transition.png", "grid": [5, 2], "frames": [[0,0],[1,0],[2,0],[3,0],[4,0],[0,1],[1,1],[2,1],[3,1],[4,1],[4,1],[3,1],[2,1],[1,1],[0,1],[4,0],[3,0],[2,0],[1,0],[0,0]], "fps": 24, "frame_durations_ms": [140,140,140,160,180,220,180,160,140,140,1500,140,160,180,220,180,160,140,140,140], "loop": false, "interruptible": false},
    "sleepy": {"source": "animations/sleepy.png", "grid": [4, 4], "frames": 16, "fps": 24, "frame_durations_ms": [180,180,200,220,240,300,250,250,1200,250,250,240,220,200,180,180], "loop": false, "interruptible": false},
    "sit_transition": {"source": "animations/sit_transition.png", "grid": [5, 2], "frames": 10, "fps": 24, "frame_durations_ms": [140, 140, 140, 160, 180, 220, 180, 160, 140, 140], "loop": false, "interruptible": false},
    "stretch": {"source": "animations/tidy_hair.png", "grid": [4, 3], "frames": 12, "fps": 24, "frame_durations_ms": [240, 180, 180, 180, 180, 320, 420, 320, 260, 240, 220, 180], "loop": false, "interruptible": true},
    "critical": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [1, 1]},
    "sleep": {"file": "rita_sprite_sheet.png", "grid": [3, 2], "cell": [2, 1]},
    "sleep_react": {"source": "animations/sleep_react.png", "grid": [4, 2], "frames": 8, "fps": 20, "frame_durations_ms": [320, 240, 240, 360, 420, 360, 260, 200], "loop": false, "cooldown": 1000, "interruptible": false}
